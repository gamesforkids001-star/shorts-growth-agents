[
 {
  "slug": "remove-duplicate-lines",
  "name": "Remove Duplicate Lines",
  "description": "Paste a list and instantly remove repeated lines, with optional case-insensitive matching.",
  "angles": [
   "clean a list with repeated lines",
   "case-insensitive matching option",
   "tidy a list of names or emails",
   "instant result after you paste",
   "text stays in your browser"
  ],
  "demos": [
   {
    "id": "fruit-list",
    "title": "Removing repeated lines from a short list",
    "steps": [
     {
      "do": "type",
      "selector": "#dl-in",
      "text": "apple\nbanana\napple\ncherry\nbanana\ndate",
      "label": "list box",
      "delay": 55
     },
     {
      "do": "click",
      "selector": "#dl-go",
      "label": "remove duplicates option"
     },
     {
      "do": "highlight",
      "selector": "#dl-out",
      "label": "result box",
      "hold_ms": 2500
     }
    ]
   },
   {
    "id": "ignore-case",
    "title": "Matching repeated names regardless of letter case",
    "steps": [
     {
      "do": "type",
      "selector": "#dl-in",
      "text": "Alice\nbob\nALICE\nCarol\nBob",
      "label": "list box",
      "delay": 55
     },
     {
      "do": "click",
      "selector": "#dl-ci",
      "label": "case-insensitive option"
     },
     {
      "do": "click",
      "selector": "#dl-go",
      "label": "remove duplicates option"
     },
     {
      "do": "highlight",
      "selector": "#dl-out",
      "label": "result box",
      "hold_ms": 2500
     }
    ]
   }
  ]
 },
