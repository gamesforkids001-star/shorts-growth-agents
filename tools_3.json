[
 {
  "slug": "rotate-pdf",
  "name": "Rotate PDF",
  "description": "Fix sideways or upside-down pages by rotating some or all pages of a PDF.",
  "angles": [
   "fix a sideways scanned page",
   "fix upside-down pages",
   "rotate only some pages or all of them",
   "quick fix on your phone",
   "files stay in your browser"
  ],
  "demos": [
   {
    "id": "rotate-90",
    "title": "Rotating a PDF by 90 degrees",
    "steps": [
     {
      "do": "upload",
      "selector": "#rp-file",
      "files": [
       "samples/doc-a.pdf"
      ],
      "label": "PDF file",
      "after_ms": 1200
     },
     {
      "do": "select",
      "selector": "#rp-angle",
      "value": "90",
      "label": "rotation angle list"
     },
     {
      "do": "click",
      "selector": "#rp-go",
      "label": "rotate option"
     }
    ]
   },
   {
    "id": "rotate-180",
    "title": "Turning a PDF upside down by 180 degrees",
    "steps": [
     {
      "do": "upload",
      "selector": "#rp-file",
      "files": [
       "samples/doc-b.pdf"
      ],
      "label": "PDF file",
      "after_ms": 1200
     },
     {
      "do": "select",
      "selector": "#rp-angle",
      "value": "180",
      "label": "rotation angle list"
     },
     {
      "do": "click",
      "selector": "#rp-go",
      "label": "rotate option"
     }
    ]
   }
  ]
 },
 {
  "slug": "jpg-to-pdf",
  "name": "JPG to PDF",
  "description": "Turn one or more JPG, PNG or WebP images into a single PDF file, in the order you choose.",
  "angles": [
   "turn photos into one PDF",
   "put images in the order you choose",
   "make a PDF from a few phone photos",
   "works with JPG, PNG and WebP",
   "no app to install"
  ],
  "demos": [
   {
    "id": "two-images",
    "title": "Putting two images into one PDF",
    "steps": [
     {
      "do": "upload",
      "selector": "#jp-file",
      "files": [
       "samples/photo.jpg",
       "samples/photo.png"
      ],
      "label": "two images",
      "after_ms": 1200
     },
     {
      "do": "highlight",
      "selector": "#jp-list",
      "label": "image list",
      "hold_ms": 2500
     },
     {
      "do": "select",
      "selector": "#jp-fit",
      "value": "a4",
      "label": "page size list"
     },
     {
      "do": "click",
      "selector": "#jp-go",
      "label": "create PDF option"
     }
    ]
   },
   {
    "id": "original-size",
    "title": "Making a PDF at the image's original size",
    "steps": [
     {
      "do": "upload",
      "selector": "#jp-file",
      "files": [
       "samples/photo.jpg"
      ],
      "label": "image",
      "after_ms": 1200
     },
     {
      "do": "select",
      "selector": "#jp-fit",
      "value": "orig",
      "label": "page size list"
     },
     {
      "do": "click",
      "selector": "#jp-go",
      "label": "create PDF option"
     }
    ]
   }
  ]
 },
